{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["./artifacts/ops/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../artifacts/api-server/src/routes/ops/routers.ts",
    "../../artifacts/api-server/src/routes/ops/trpc.ts",
    "../../artifacts/api-server/src/routes/ops/context.ts"
  ]
}
